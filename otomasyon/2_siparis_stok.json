        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Stok tablosunu oku",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [720, 0],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Siparişteki adetleri ürün koduna göre topla, Stok sayfasındaki değerden düş.\nconst satirlar = $('Satırlara böl').all().map(i => i.json);\nconst stok = new Map($input.all().map(i => [String(i.json.urun_kodu), i.json]));\nconst dusulen = new Map();\nfor (const s of satirlar) {\n  dusulen.set(s.urun_kodu, (dusulen.get(s.urun_kodu) || 0) + s.adet);\n}\nconst cikti = [];\nfor (const [kod, adet] of dusulen) {\n  const satir = stok.get(kod);\n  if (!satir) continue; // Stok sayfasında olmayan ürün: atlanır\n  const yeni = Number(satir.stok) - adet;\n  const esik = Number(satir.esik) || 0;\n  cikti.push({ json: {\n    urun_kodu: kod,\n    urun_adi: satir.urun_adi || kod,\n    stok: yeni,\n    esik,\n    azaldi: yeni <= esik,\n  } });\n}\nreturn cikti;"
      },
