{
  "name": "2 · Sipariş tabloya, stok azalınca Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "siparis",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Siteden sipariş",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [0, 0],
      "webhookId": "b2000000-0000-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "jsCode": "// Webhook gövdesi beklenen biçim:\n// { \"siparis_no\": \"1001\", \"urunler\": [ { \"urun_kodu\": \"A1\", \"urun_adi\": \"Ürün A\", \"adet\": 2, \"birim_fiyat\": 250 } ] }\n// Müşteri adı/telefonu bilerek tabloya yazılmıyor: özet için gerekmiyor.\nconst gun = $now.toFormat('yyyy-MM-dd');\nconst saat = $now.toFormat('HH:mm');\nconst cikti = [];\nfor (const item of $input.all()) {\n  const b = item.json.body || {};\n  for (const u of (b.urunler || [])) {\n    const adet = Number(u.adet) || 0;\n    const fiyat = Number(u.birim_fiyat) || 0;\n    cikti.push({ json: {\n      gun,\n      saat,\n      siparis_no: String(b.siparis_no ?? ''),\n      urun_kodu: String(u.urun_kodu ?? ''),\n      urun_adi: String(u.urun_adi ?? ''),\n      adet,\n      birim_fiyat: fiyat,\n      tutar: adet * fiyat,\n    } });\n  }\n}\nreturn cikti;"
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Satırlara böl",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "<GOOGLE_SHEETS_ADRESIN>"
