      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Tabloya yaz (Siparisler)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [480, 0]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "<GOOGLE_SHEETS_ADRESIN>"
        },
        "sheetName": {
