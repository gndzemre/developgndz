{
  "name": "3 · Akşam özeti: günün rakamları ekip kanalına",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 18,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "c3000000-0000-4000-8000-000000000001",
      "name": "Her akşam 18:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "<GOOGLE_SHEETS_ADRESIN>"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Siparisler"
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Siparişleri oku",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [240, 0],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Siparisler sayfasından yalnız bugünün satırlarını al, özeti tek mesaja çevir.\nconst bugun = $now.toFormat('yyyy-MM-dd');\nconst satirlar = $input.all().map(i => i.json).filter(r => String(r.gun) === bugun);\nconst siparisler = new Set(satirlar.map(r => String(r.siparis_no)));\nconst ciro = satirlar.reduce((t, r) => t + (Number(r.tutar) || 0), 0);\nconst adetler = {};\nfor (const r of satirlar) {\n  const ad = r.urun_adi || r.urun_kodu;\n  adetler[ad] = (adetler[ad] || 0) + (Number(r.adet) || 0);\n}\nconst enCok = Object.entries(adetler).sort((a, b) => b[1] - a[1])[0];\nconst tl = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 2 }).format(ciro);\nconst metin = satirlar.length === 0\n  ? `Günün özeti (${bugun})\\nBugün sipariş yok.`\n  : `Günün özeti (${bugun})\\nSipariş: ${siparisler.size}\\nCiro: ${tl} TL\\nEn çok satan: ${enCok[0]} (${enCok[1]} adet)`;\nreturn [{ json: { metin } }];"
      },
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "Özeti hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "<SLACK_KANAL_ID>"
        },
        "text": "={{ $json.metin }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Ekip kanalına gönder (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [720, 0]
    }
  ],
  "connections": {
